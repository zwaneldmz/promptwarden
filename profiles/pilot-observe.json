{
  "version": 1,
  "name": "Pilot — Observe (weeks 1–2)",
  "hosts": [
    "chatgpt.com",
    "chat.openai.com",
    "claude.ai",
    "gemini.google.com",
    "copilot.microsoft.com",
    "chat.mistral.ai",
    "www.perplexity.ai"
  ],
  "defaultAction": "observe",
  "logging": "event",
  "onError": "open",
  "retentionDays": 90,
  "bulkPiiThreshold": 5,
  "rules": [
    {
      "detector": "credit_card",
      "action": "observe"
    },
    {
      "detector": "iban",
      "action": "observe"
    },
    {
      "detector": "at_svnr",
      "action": "observe"
    },
    {
      "detector": "api_key",
      "action": "observe"
    },
    {
      "detector": "bulk_pii",
      "action": "observe"
    },
    {
      "detector": "email",
      "action": "observe"
    },
    {
      "detector": "phone",
      "action": "observe"
    }
  ]
}